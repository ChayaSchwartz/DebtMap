# ---------------------------------------------------------------------------
# Copy to .env and fill in. Values below match docker-compose.yml defaults.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=3100

# Comma-separated origins allowed to call the API.
CORS_ORIGINS=http://localhost:4200

DATABASE_URL=postgresql://debtmap:debtmap@localhost:5432/debtmap?schema=public
REDIS_URL=redis://localhost:6379

# Read-only PAT (public_repo scope is enough; no scope at all also works).
# Without it GitHub allows 60 requests/hour, which the tool exhausts quickly.
GITHUB_TOKEN=

# Google AI Studio key. Flash-Lite is the only free-tier model with 1000 RPD.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# --- Analysis limits -------------------------------------------------------
# MAX_FILES is deliberately an env var: Semgrep memory use on the deploy
# target is unverified, and this is the dial we turn without a redeploy.
MAX_FILES=5000
MAX_REPO_SIZE_MB=1024
CLONE_TIMEOUT_MS=300000

# --- Security scanners -----------------------------------------------------
# Comma-separated. Drop a source here to run without it: a host with no
# semgrep binary, or a deployment with no outbound network for OSV, should
# lose that one scanner rather than the whole security dimension. An omitted
# source is reported as "skipped", never as "found nothing".
SECURITY_SOURCES=semgrep,gitleaks,osv
SEMGREP_TIMEOUT_MS=600000
GITLEAKS_TIMEOUT_MS=300000
OSV_TIMEOUT_MS=120000

# Comma-separated Semgrep rulesets. Empty uses the built-in defaults
# (p/security-audit, p/javascript, p/typescript). `auto` is deliberately not
# the default: it fingerprints the project to the registry and returns rules
# that change between runs.
SEMGREP_CONFIG=

# Absolute or relative path where repositories are cloned and then deleted.
WORKSPACE_DIR=.debtmap-workspace

# --- AI budget -------------------------------------------------------------
# Free tier: 15 requests/minute, 1000 requests/day. The per-minute ceiling is
# the binding constraint, which is why explanations per run are capped.
AI_MAX_FILES_PER_RUN=15
AI_REQUESTS_PER_MINUTE=15
AI_DAILY_REQUEST_BUDGET=900
DAILY_REPO_BUDGET=60
